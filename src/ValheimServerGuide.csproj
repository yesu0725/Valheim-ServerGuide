<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ValheimServerGuide</AssemblyName>
    <RootNamespace>ValheimServerGuide</RootNamespace>
    <Version>0.16.1</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- CS0618: TMP_Text.enableWordWrapping is flagged obsolete in this TMP build but the
         replacement (textWrappingMode) may not exist in Valheim's shipped runtime TMP, so we
         keep the obsolete property for runtime safety. -->
    <NoWarn>CS0436;NU1701;CS0618</NoWarn>
    <!-- Override on other machines: dotnet build -p:VALHEIM_INSTALL="D:\Games\Valheim" -->
    <VALHEIM_INSTALL Condition=" '$(VALHEIM_INSTALL)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <ManagedDir>$(VALHEIM_INSTALL)\valheim_Data\Managed</ManagedDir>
    <!-- Test client: the Gale profile "HB Test" (replaced the old r2modman profile).
         Override on other machines: dotnet build -p:TEST_PROFILE_DIR="..." -->
    <TEST_PROFILE_DIR Condition=" '$(TEST_PROFILE_DIR)' == '' ">C:\Users\yesu0725\AppData\Roaming\com.kesomannen.gale\valheim\profiles\HB Test</TEST_PROFILE_DIR>
    <TestProfileInstallDir>$(TEST_PROFILE_DIR)\BepInEx\plugins\TaegukGaming-ValheimServerGuide</TestProfileInstallDir>
    <!-- Override on other machines: dotnet build -p:VALHEIM_DEDICATED_SERVER_DIR="..." -->
    <VALHEIM_DEDICATED_SERVER_DIR Condition=" '$(VALHEIM_DEDICATED_SERVER_DIR)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server</VALHEIM_DEDICATED_SERVER_DIR>
    <DedicatedServerInstallDir>$(VALHEIM_DEDICATED_SERVER_DIR)\BepInEx\plugins\TaegukGaming-ValheimServerGuide</DedicatedServerInstallDir>
    <!-- The Thunderstore package folder: the single source of truth for manifest.json. -->
    <!-- BepInEx is NOT part of the game install any more: the Valheim 1.0 update wiped
         `<game>\BepInEx`, and the mod managers keep their own copy per profile. Resolve
         the first root that actually has the core assemblies.
         Override on other machines: dotnet build -p:BEPINEX_DIR="..." -->
    <BEPINEX_DIR Condition=" '$(BEPINEX_DIR)' == '' AND Exists('$(VALHEIM_INSTALL)\BepInEx\core\BepInEx.dll') ">$(VALHEIM_INSTALL)\BepInEx</BEPINEX_DIR>
    <BEPINEX_DIR Condition=" '$(BEPINEX_DIR)' == '' AND Exists('$(TEST_PROFILE_DIR)\BepInEx\core\BepInEx.dll') ">$(TEST_PROFILE_DIR)\BepInEx</BEPINEX_DIR>
    <BEPINEX_DIR Condition=" '$(BEPINEX_DIR)' == '' AND Exists('$(VALHEIM_DEDICATED_SERVER_DIR)\BepInEx\core\BepInEx.dll') ">$(VALHEIM_DEDICATED_SERVER_DIR)\BepInEx</BEPINEX_DIR>
    <BepInExDir>$(BEPINEX_DIR)</BepInExDir>
    <PluginInstallDir>$(BepInExDir)\plugins\ValheimServerGuide</PluginInstallDir>
    <ThunderstorePackageDir>$(MSBuildProjectDirectory)\..\Thunderstore files\ValheimServerGuide</ThunderstorePackageDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>$(ManagedDir)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(BepInExDir)\plugins\ValheimModding-Jotunn\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The version players actually see is the [BepInPlugin] one, i.e. the PluginVersion const in
       Plugin.cs — that is what BepInEx registers, what the log line reports and what mod managers
       display. <Version> above only stamps the assembly. The two are separate strings, so bumping
       one and forgetting the other ships a package whose manifest and in-game version disagree.
       This fails the build instead. -->
  <Target Name="VerifyPluginVersion" BeforeTargets="Build">
    <PropertyGroup>
      <_PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Plugin.cs'))</_PluginSource>
      <_ExpectedVersionConst>PluginVersion = "$(Version)"</_ExpectedVersionConst>
    </PropertyGroup>
    <Error Condition="!$(_PluginSource.Contains('$(_ExpectedVersionConst)'))"
           Text="Plugin.cs does not declare [$(_ExpectedVersionConst)]. The &lt;Version&gt; property is $(Version), so set PluginVersion in Plugin.cs to match — otherwise the mod reports the old version in-game and in mod managers while the assembly and Thunderstore manifest say $(Version)." />
  </Target>

  <!-- Fourth version string. VerifyPluginVersion covers <Version> vs Plugin.cs; this covers
       <Version> vs the Thunderstore manifest, which is the one every mod manager DISPLAYS.
       Without it the manifest silently stays a release behind and Gale/r2modman keep reporting
       the old version over a new DLL. -->
  <Target Name="VerifyManifestVersion" BeforeTargets="Build"
          Condition="Exists('$(ThunderstorePackageDir)\manifest.json')">
    <PropertyGroup>
      <_ManifestSource>$([System.IO.File]::ReadAllText('$(ThunderstorePackageDir)\manifest.json'))</_ManifestSource>
      <_ExpectedManifestVersion>"version_number": "$(Version)"</_ExpectedManifestVersion>
    </PropertyGroup>
    <Error Condition="!$(_ManifestSource.Contains('$(_ExpectedManifestVersion)'))"
           Text="Thunderstore manifest.json does not declare [$(_ExpectedManifestVersion)]. The &lt;Version&gt; property is $(Version), so set version_number in &quot;Thunderstore files/ValheimServerGuide/manifest.json&quot; to match — otherwise mod managers report the old version over the new DLL." />
  </Target>

  <!-- Every deploy target that was installed by a mod manager carries its own manifest.json,
       and THAT is the version Gale / r2modman show in their mod list — not the assembly. The
       DLL-only copy below used to leave it untouched, so a freshly built target kept reporting
       the previous release. Keep the manifest in step with the DLL wherever one exists. -->
  <!-- Gale (and r2modman) install a mod by HARD-LINKING one cached copy into every profile
       that uses it, so all those paths share a single inode. MSBuild's Copy overwrites a
       destination in place, which writes THROUGH the link: deploying a dev build to the test
       profile silently replaced the published DLL in the download cache and in every other
       profile - including live ones - with no sign that anything had happened. Deleting the
       destination first breaks it out of the link group, so a deploy only touches its own
       target. Every Copy into a mod-manager-managed folder must be preceded by this. -->
  <Target Name="DeployManifest" AfterTargets="Build"
          Condition="Exists('$(ThunderstorePackageDir)\manifest.json')">
    <Delete Files="$(TestProfileInstallDir)\manifest.json" Condition="Exists('$(TestProfileInstallDir)\manifest.json')" />
    <Copy SourceFiles="$(ThunderstorePackageDir)\manifest.json"
          DestinationFolder="$(TestProfileInstallDir)"
          Condition="Exists('$(TestProfileInstallDir)\manifest.json')" />
    <!-- The two below follow the deploy policy above: only with DEPLOY_ALL_TARGETS=true. -->
    <Delete Files="$(DedicatedServerInstallDir)\manifest.json" Condition="'$(DEPLOY_ALL_TARGETS)' == 'true' And Exists('$(DedicatedServerInstallDir)\manifest.json')" />
    <Copy SourceFiles="$(ThunderstorePackageDir)\manifest.json"
          DestinationFolder="$(DedicatedServerInstallDir)"
          Condition="'$(DEPLOY_ALL_TARGETS)' == 'true' And Exists('$(DedicatedServerInstallDir)\manifest.json')" />
    <Delete Files="$(PluginInstallDir)\manifest.json" Condition="'$(DEPLOY_ALL_TARGETS)' == 'true' And Exists('$(PluginInstallDir)\manifest.json')" />
    <Copy SourceFiles="$(ThunderstorePackageDir)\manifest.json"
          DestinationFolder="$(PluginInstallDir)"
          Condition="'$(DEPLOY_ALL_TARGETS)' == 'true' And Exists('$(PluginInstallDir)\manifest.json')" />
  </Target>

  <!-- Release only: put the built DLL straight into the Thunderstore package folder, so that
       folder is a complete, self-consistent package the moment the build finishes.
       Deploy step 7 used to do this by hand AFTER the build, which left a window where the
       folder held the new manifest.json next to the PREVIOUS release's DLL — and the project's
       post-build zip hook fires exactly in that window, so the date-stamped snapshot it wrote
       was a 0.14.0 manifest packaged around a 0.13.1 DLL. Debug builds are excluded: a Debug
       binary must never end up in the published package. -->
  <Target Name="DeployToThunderstorePackage" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And Exists('$(ThunderstorePackageDir)')">
    <Delete Files="$(ThunderstorePackageDir)\ValheimServerGuide.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstorePackageDir)" />
    <Message Text="Deployed ValheimServerGuide to $(ThunderstorePackageDir)" Importance="high" />
  </Target>

  <!-- DEPLOY POLICY: a plain `dotnet build` copies the DLL to ONE place - the Gale "HB Test"
       profile (DeployToTestProfile). Nothing else. The dedicated server and the game-install
       BepInEx folder are opt-in:  dotnet build -p:DEPLOY_ALL_TARGETS=true
       Why: the server and the other Gale profiles run the PUBLISHED build that Gale installs
       from Thunderstore, and a dev build landing there silently replaced it - the server was
       running unreleased code with nobody's say-so. Only the test profile should ever receive a
       build that has not been through a release. (Gale hard-links one cached copy into every
       profile; the Delete-before-Copy below is what stops a test-profile deploy writing through
       that link into the live profiles as well.) -->
  <!-- YamlDotNet.dll is intentionally NOT copied: r2modman pulls it in via the
       ValheimModding-YamlDotNet package that's a transitive dep of Jötunn. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build"
          Condition="'$(DEPLOY_ALL_TARGETS)' == 'true' And Exists('$(VALHEIM_INSTALL)\BepInEx\core\BepInEx.dll')">
    <MakeDir Directories="$(PluginInstallDir)" />
    <Delete Files="$(PluginInstallDir)\ValheimServerGuide.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginInstallDir)" />
    <Message Text="Deployed ValheimServerGuide to $(PluginInstallDir)" Importance="high" />
  </Target>

  <!-- Test client (Gale profile). The DLL goes in the mod's own subfolder, not straight into
       plugins/: BepInEx scans recursively, so a second copy loose in plugins/ would be a
       duplicate of the Thunderstore-installed one and one of them would be skipped. -->
  <Target Name="DeployToTestProfile" AfterTargets="Build" Condition="Exists('$(TEST_PROFILE_DIR)')">
    <MakeDir Directories="$(TestProfileInstallDir)" />
    <Delete Files="$(TestProfileInstallDir)\ValheimServerGuide.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TestProfileInstallDir)" />
    <Message Text="Deployed ValheimServerGuide to $(TestProfileInstallDir)" Importance="high" />
  </Target>

  <Target Name="DeployToDedicatedServer" AfterTargets="Build"
          Condition="'$(DEPLOY_ALL_TARGETS)' == 'true' And Exists('$(VALHEIM_DEDICATED_SERVER_DIR)')">
    <MakeDir Directories="$(DedicatedServerInstallDir)" />
    <Delete Files="$(DedicatedServerInstallDir)\ValheimServerGuide.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DedicatedServerInstallDir)" />
    <Message Text="Deployed ValheimServerGuide to $(DedicatedServerInstallDir)" Importance="high" />
  </Target>

</Project>
